# Copy the Atlas connection string and replace its credentials.
MONGO_URI=mongodb+srv://replace-user:replace-password@replace-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=football

# Alternative for the existing cluster0.wbx8bpm.mongodb.net Atlas cluster:
# Remove MONGO_URI above and leave MONGO_HOST unset, including in production.
# username=replace-user
# password=replace-password

ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password
FLASK_SECRET_KEY=replace-with-at-least-32-random-bytes

# Set false only for local HTTP development; production must use HTTPS.
COOKIE_SECURE=true
